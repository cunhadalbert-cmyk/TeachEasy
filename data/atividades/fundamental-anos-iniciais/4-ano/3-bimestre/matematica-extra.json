        {
          "numero": 1,
          "tipo": "problema",
          "enunciado": "Uma professora tem 47 lápis para repartir igualmente entre 6 grupos. Quantos lápis cada grupo recebe e quantos sobram?",
          "alternativas": [],
          "espacoResposta": "medio",
          "figuraId": null
        },
        {
          "numero": 2,
          "tipo": "multipla-escolha",
          "enunciado": "Em 53 ÷ 5, qual é o quociente e qual é o resto?",
          "alternativas": [
            "Quociente 10 e resto 3",
            "Quociente 11 e resto 2",
            "Quociente 9 e resto 8",
            "Quociente 5 e resto 3"
          ],
          "espacoResposta": "pequeno",
          "figuraId": null
        },
        {
          "numero": 3,
          "tipo": "resposta-curta",
          "enunciado": "Uma van leva 8 estudantes por viagem. Quantas viagens completas são necessárias para transportar 34 estudantes? Considere que todos precisam viajar.",
          "alternativas": [],
          "espacoResposta": "medio",
          "figuraId": null
        },
        {
          "numero": 4,
          "tipo": "analise-erro",
          "enunciado": "João disse que 29 ÷ 4 = 7 e não há sobra. Verifique e corrija a afirmação.",
          "alternativas": [],
          "espacoResposta": "medio",
          "figuraId": null
        },
        {
          "numero": 5,
          "tipo": "completar",
          "enunciado": "Complete: 65 ÷ 8 = ____ e resto ____.",
          "alternativas": [],
          "espacoResposta": "pequeno",
          "figuraId": null
        },
        {
          "numero": 6,
          "tipo": "elaboracao",
          "enunciado": "Crie um problema de divisão cujo resultado seja 9 e resto 2. Depois, resolva-o.",
          "alternativas": [],
          "espacoResposta": "grande",
          "figuraId": null
        }
      ],
      "gabarito": [
        {
          "numero": 1,
          "resposta": "7 lápis para cada grupo e sobram 5.",
          "justificativa": "47 = 6 × 7 + 5."
        },
        {
          "numero": 2,
          "resposta": "Alternativa A.",
          "justificativa": "53 = 5 × 10 + 3."
        },
        {
          "numero": 3,
          "resposta": "5 viagens.",
          "justificativa": "Quatro viagens levam 32 estudantes; é necessária mais uma para os 2 restantes."
        },
        {
          "numero": 4,
          "resposta": "29 ÷ 4 = 7 e resto 1.",
          "justificativa": "4 × 7 = 28 e sobra 1."
        },
        {
          "numero": 5,
          "resposta": "8 e resto 1.",
          "justificativa": "65 = 8 × 8 + 1."
        },
        {
          "numero": 6,
          "resposta": "Resposta pessoal.",
          "justificativa": "Critério de correção: o enunciado deve representar uma divisão coerente com dividendo igual a 9 vezes o divisor mais 2."
        }
      ],
